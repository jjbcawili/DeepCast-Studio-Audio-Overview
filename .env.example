# DeepCast Studio — Audio Overview environment template
# Copy this file to .env.local for local development.
# Never commit real secrets.

# Required: Google Gemini API key used for outline and script generation.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Required: ElevenLabs API key used for voice previews and podcast audio generation.
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# Optional: Override the default ElevenLabs voice IDs.
JIRO_ELEVENLABS_VOICE_ID="pe3VMth5BPRL0ZY3J9lc"
SHARPAY_ELEVENLABS_VOICE_ID="uC66YjdAMHXrcaX6MoXS"

# Optional: Public URL where the application is hosted.
APP_URL="MY_APP_URL"

# Optional: Server port. Defaults to 3000 when omitted.
PORT="3000"
